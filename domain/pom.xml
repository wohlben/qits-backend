    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
                <!-- The fixtures dir holds the committed bare submodule-*.git repos AND four
                     git-submodule working trees (testing-repo, testing-repo-angular,
                     testing-repo-quarkus-angular, testing-repo-quarkus-lit). Copy only the plain
                     bares; the submodule working
                     trees are turned into bare *.git repos on the classpath by the
                     derive-fixture-bares antrun step below (a working tree is not a bare, and one
                     carries node_modules/target once built). -->
                <excludes>
                    <exclude>fixtures/testing-repo/**</exclude>
                    <exclude>fixtures/testing-repo-angular/**</exclude>
                    <exclude>fixtures/testing-repo-quarkus-angular/**</exclude>
                    <exclude>fixtures/testing-repo-quarkus-lit/**</exclude>
                </excludes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <!-- Isolated-test chunking: every @TestProfile/@WithTestResource class pins a full
                 Quarkus app (curated app + augmentation + runtime classloader) in its fork's
                 metaspace for the fork's whole lifetime (quarkusio/quarkus#38774), and JUnit's
                 single discovery pass materializes ALL of them up front — one fork running the whole
                 suite grows to ~4 GiB and is OOM-killed. So: the default execution runs the entire
                 profile-less remainder against ONE shared app, and the isolated classes run in
                 chunked extra executions (a fresh fork each, ~5 apps max per fork). The chunk lists
                 are derived by scripts/list-isolated-tests.sh (antrun below); -Dtest=... collapses
                 back to a single plain execution via the root pom's single-test-override profile.
                 See docs/issues/resolved/2026-07-25_quarkus-test-metaspace-oom.md. -->
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-test</id>
                        <configuration>
                            <excludesFile>${qits.default-test.excludes}</excludesFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>isolated-tests-1</id>
                        <goals><goal>test</goal></goals>
                        <configuration>
                            <skip>${qits.isolated-tests.skip}</skip>
                            <includesFile>${project.build.directory}/isolated-tests-1.txt</includesFile>
                            <!-- Distinct per execution: surefire skips a repeated run whose config
                                 hash matches a previous one, and includesFile is not hashed. -->
                            <systemPropertyVariables>
                                <qits.isolated-tests.chunk>1</qits.isolated-tests.chunk>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                    <execution>
                        <id>isolated-tests-2</id>
