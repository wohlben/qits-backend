<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>eu.wohlben</groupId>
        <artifactId>qits</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>auth-local</artifactId>

    <!-- The `local` build variant (docs/epics/qits-authentication/): explicitly UNAUTHENTICATED, for
         trusted local starts (a workspace's own packaged qits behind the parent proxy on qits-net; a
         laptop run). Like auth-forwardauth it is a plain library jar carrying its own jandex index so
         the consuming app auto-discovers its single HttpAuthenticationMechanism. Unlike forwardauth,
         its identity is unconditional and NOT LaunchMode-guarded — it works in NORMAL (packaged)
         mode, which is its whole purpose. Never internet-expose a local-variant qits. -->

    <dependencies>
        <dependency>
            <groupId>eu.wohlben</groupId>
            <artifactId>auth-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
