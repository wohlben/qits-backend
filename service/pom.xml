            </plugin>
            <plugin>
                <!-- Every PACKAGED service build must choose an auth variant explicitly — a shipped
                     qits never defaults its auth (docs/epics/qits-authentication/features/2026-07-16_build-variant-auth.md).
                     The -D property activates the matching profile in <profiles> below AND satisfies
                     this rule with one flag. Bound to prepare-package (not validate) on purpose:
                     pre-packaging work — quarkus:dev, test — runs flagless via the
                     variant-default-forwardauth profile below; only producing an artifact
                     (package/install/verify) reaches this rule. -->
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>require-auth-variant</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireProperty>
                                    <property>qits.variant</property>
                                    <regex>oauth|forwardauth|local</regex>
                                    <message>Packaging qits requires an explicit auth variant for the service app:
  -Dqits.variant=forwardauth   trust forward-auth proxy headers (Remote-User/Remote-Groups) — the everyday dev/test variant
  -Dqits.variant=oauth         built-in OIDC login (Keycloak); requires QUARKUS_OIDC_* env at runtime
  -Dqits.variant=local         EXPLICITLY UNAUTHENTICATED — every request is a fixed local user. Trusted LOCAL starts only
                               (a workspace's own packaged qits behind the parent on qits-net; a laptop run). NEVER internet-expose.
(quarkus:dev and test default to forwardauth without the flag — a packaged build never defaults. The
 auth-scheme variants forwardauth/oauth never run unauthenticated; only `local` does, and only when named explicitly.)
See docs/epics/qits-authentication/features/2026-07-16_build-variant-auth.md.</message>
                                    <regexMessage>Unknown qits.variant — valid values are: forwardauth, oauth, local.
See docs/epics/qits-authentication/features/2026-07-16_build-variant-auth.md.</regexMessage>
                                </requireProperty>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Derive the submodule-committed git fixtures into bare repos on the test classpath
                 (scripts/derive-fixture-bares.sh); runAlways in the build cache. See domain/pom.xml. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>derive-fixture-bares</id>
                        <phase>process-test-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <!-- Skipped in tests-skipped, no-submodule builds (the Docker images);
                                 see qits.fixture-derivation.skip in the root pom. -->
                            <skip>${qits.fixture-derivation.skip}</skip>
                            <target>
                                <exec executable="bash" failonerror="true">
                                    <arg value="${maven.multiModuleProjectDirectory}/scripts/derive-fixture-bares.sh"/>
                                    <arg value="${maven.multiModuleProjectDirectory}/domain/src/test/resources/fixtures"/>
                                    <arg value="${project.build.testOutputDirectory}/fixtures"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                    <!-- Derive the isolated-test chunk lists consumed by the surefire executions
                         above (scripts/list-isolated-tests.sh; chunk count matches the number of
                         isolated-tests-N executions). -->
                    <execution>
                        <id>list-isolated-tests</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="bash" failonerror="true">
                                    <arg value="${maven.multiModuleProjectDirectory}/scripts/list-isolated-tests.sh"/>
                                    <arg value="${project.basedir}/src/test/java"/>
                                    <arg value="${project.build.directory}"/>
                                    <arg value="15"/>
                                </exec>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
