    <artifactId>service</artifactId>
    <packaging>quarkus</packaging>

    <properties>
        <!-- The full web app needs more test-fork heap than the library modules (root default
             384m): a single service boot (augmentation + REST + MCP + JGit + Quinoa test wiring)
             OOMs a 384m heap. -->
        <qits.test.heap>512m</qits.test.heap>
    </properties>

